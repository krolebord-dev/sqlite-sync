{
  "version": "0.9.3",
  "name": "sqlite-sync-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @sqlite-sync/example dev",
    "dev:server": "pnpm --filter @sqlite-sync/example dev:server",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "publish:packages": "pnpm --filter './packages/**' publish --access public --no-git-checks",
    "publish:dry": "pnpm --filter './packages/**' publish --access public --dry-run",
    "version": "node ./scripts/version-packages.mjs && git add --all",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "format": "biome check --write",
    "format:check": "biome check",
    "test": "pnpm --filter './packages/**' test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/node": "^22.19.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "globals": "^16.5.0",
    "lefthook": "^2.1.1",
    "typescript": "catalog:"
  }
}
