{
  "name": "@sqlite-sync/ai",
  "version": "0.12.1",
  "description": "AI agent tools and MCP helpers for @sqlite-sync databases",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krolebord-dev/sqlite-sync",
    "directory": "packages/ai"
  },
  "keywords": [
    "sqlite",
    "sync",
    "ai",
    "agent",
    "tools",
    "mcp",
    "offline-first",
    "local-first"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@sqlite-sync/source": "./src/index.ts",
      "workerd": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "@sqlite-sync/source": "./src/mcp.ts",
      "workerd": "./src/mcp.ts",
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mcp": {
        "types": "./dist/mcp.d.ts",
        "import": "./dist/mcp.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sqlite-sync/core": "^0.12.1",
    "ai": "^6.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@sqlite-sync/core": "workspace:*",
    "ai": "catalog:",
    "tsdown": "0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.8",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
