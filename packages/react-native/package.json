{
  "name": "@sqlite-sync/react-native",
  "version": "0.13.3",
  "description": "React Native (op-sqlite) adapter for @sqlite-sync/core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krolebord-dev/sqlite-sync",
    "directory": "packages/react-native"
  },
  "keywords": [
    "sqlite",
    "sync",
    "crdt",
    "react-native",
    "op-sqlite",
    "offline-first",
    "local-first"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@sqlite-sync/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@op-engineering/op-sqlite": ">=18.2.0",
    "@sqlite-sync/core": "^0.13.3",
    "kysely": "^0.28.0 || ^0.29.0",
    "react-native": ">=0.76.0",
    "react-native-get-random-values": "^1.11.0 || ^2.0.0"
  },
  "devDependencies": {
    "@op-engineering/op-sqlite": "18.2.5",
    "@sqlite-sync/core": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "kysely": "catalog:",
    "react": "catalog:",
    "react-native": "0.87.1",
    "react-native-get-random-values": "2.0.0",
    "tsdown": "0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  }
}
