{
  "name": "@sqlite-sync/react",
  "version": "0.9.3",
  "description": "React bindings for @sqlite-sync/core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krolebord-dev/sqlite-sync",
    "directory": "packages/react"
  },
  "keywords": [
    "sqlite",
    "sync",
    "react",
    "hooks",
    "offline-first",
    "local-first"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@sqlite-sync/source": "./src/index.ts",
      "workerd": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@sqlite-sync/core": "^0.9.3",
    "kysely": "^0.28.0 || ^0.29.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@sqlite-sync/core": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "jsdom": "^27.0.0",
    "kysely": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  }
}
