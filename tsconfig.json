{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/ai" },
    { "path": "./packages/react" },
    { "path": "./packages/react-native" },
    { "path": "./packages/devtools" },
    { "path": "./apps/example" },
    { "path": "./packages/cloudflare" }
  ]
}
